{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://universalos.dev/specs/recovery/proof-v1.json","title":"UniversalOS recovery proof v1","type":"object","additionalProperties":false,"required":["schema_version","adapter_id","profile_id","build_id","offline_restore","scenario","result","evidence"],"properties":{"schema_version":{"const":1},"adapter_id":{"type":"string"},"profile_id":{"type":"string"},"build_id":{"type":"string"},"offline_restore":{"type":"object","additionalProperties":false,"required":["artifact_sha256","data_loss_disclosed"],"properties":{"artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"data_loss_disclosed":{"type":"boolean"}}},"scenario":{"enum":["invalid-system","interrupted-update","failed-health","manual-recovery"]},"result":{"enum":["recovered","failed","not-run"]},"evidence":{"type":"string","minLength":1,"maxLength":500}}}
