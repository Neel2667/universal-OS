{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalos.dev/specs/repository-metadata/envelope-v1.json",
  "title": "UniversalOS Signed Repository Metadata Envelope v1",
  "description": "A canonical-JSON Ed25519 signed metadata envelope. Signatures cover every field except the signatures array. This schema is a host-side reference contract; production deployment needs independent security review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "version", "expires", "signed", "signatures"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"enum": ["root", "targets", "bootstrap", "profiles"]},
    "version": {"type": "integer", "minimum": 1},
    "expires": {"type": "string", "format": "date-time"},
    "signed": {"type": "object"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "signature"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "signature": {"type": "string", "contentEncoding": "base64"}
        }
      }
    }
  }
}
