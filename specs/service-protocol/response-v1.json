{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalos.dev/specs/service-protocol/response-v1.json",
  "title": "UniversalOS local service response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "ok"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string"},
    "ok": {"type": "boolean"},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,120}$"},
        "message": {"type": "string", "maxLength": 240}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}}, "then": {"required": ["result"]}},
    {"if": {"properties": {"ok": {"const": false}}}, "then": {"required": ["error"]}}
  ]
}
