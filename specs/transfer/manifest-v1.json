{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universalos.dev/specs/transfer/manifest-v1.json",
  "title": "UniversalOS resumable transfer manifest v1",
  "description": "Transport-only chunk map. The manifest is not an authority to install code: its artifact identity must match already verified signed targets metadata and the completed bytes must be reverified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transfer_id", "target_id", "artifact_kind", "sha256", "bytes", "chunk_bytes", "chunk_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "transfer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "artifact_kind": {"enum": ["manifest", "payload"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "chunk_bytes": {"type": "integer", "minimum": 4096, "maximum": 4194304},
    "chunk_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
