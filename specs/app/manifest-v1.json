{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://universalos.dev/specs/app/manifest-v1.json","title":"UniversalOS app manifest v1","type":"object","additionalProperties":false,"required":["schema_version","app_id","version","runtime","entry","requested_capabilities"],"properties":{"schema_version":{"const":1},"app_id":{"type":"string","pattern":"^uos\\.app\\.[a-z0-9][a-z0-9._-]*$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"runtime":{"enum":["wasi-component","native-system"]},"entry":{"type":"string","minLength":1,"maxLength":200},"requested_capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["uos.app.files.read-selected","uos.app.files.write-user-approved","uos.app.camera.capture","uos.app.microphone.record","uos.app.location.read","uos.app.network.connect","uos.app.notifications.post","uos.app.share.export"]}}}}
