{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://universalos.dev/specs/release/manifest-v1.json","title":"UniversalOS release readiness manifest v1","type":"object","additionalProperties":false,"required":["schema_version","release_id","source_revision","profile_id","target_id","sbom_sha256","test_summary","provenance_state"],"properties":{"schema_version":{"const":1},"release_id":{"type":"string","pattern":"^uos\\.release\\.[a-z0-9][a-z0-9._-]*$"},"source_revision":{"type":"string","minLength":7},"profile_id":{"type":"string"},"target_id":{"type":"string"},"sbom_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"test_summary":{"type":"object","additionalProperties":false,"required":["passed","failed"],"properties":{"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0}}},"provenance_state":{"enum":["test-only","review-pending","release-approved"]}}}
