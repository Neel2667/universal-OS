# UniversalOS native Discovery Base build container.
# Build this through Arena's container provisioning, then pin the base image
# digest in the image registry before production/release use.
FROM rust:1.85.0-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG POKY_COMMIT=1ba3cd7c884dc6c3d78c6bedc15e081f5000c8c9

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential bc bison cpio diffstat file flex gawk gcc git iproute2 \
    libegl1-mesa libsdl2-2.0-0 locales lz4 rpcsvc-proto socat texinfo \
    unzip wget xz-utils zstd python3 python3-git python3-jinja2 python3-pexpect \
    python3-pip python3-subunit qemu-system-arm qemu-utils chrpath \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-linux-gnu aarch64-unknown-none \
    && rustup component add rustfmt clippy

# GitHub is the source path selected for Arena because direct distro/Rust
# endpoints are unavailable in the current sandbox. The commit is pinned.
RUN git clone https://github.com/yoctoproject/poky.git /opt/yocto/poky \
    && cd /opt/yocto/poky \
    && git checkout --detach "${POKY_COMMIT}" \
    && git submodule update --init --recursive

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV PATH="/opt/yocto/poky:${PATH}"
WORKDIR /workspace
COPY native/environment/verify-container.sh /usr/local/bin/verify-universalos-native-env
RUN chmod 0755 /usr/local/bin/verify-universalos-native-env
